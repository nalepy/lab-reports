# Copie este archivo a data/.env y pegue sus API keys.

# DeepSeek nativo — usado para generar el informe IA (modelo por defecto).
# Crear en https://platform.deepseek.com/api_keys
#
# DEEPSEEK_API_KEY=sk-...

# OpenRouter — usado solo para visión (análisis de imágenes/estudios) y Opus 4.8.
# La key debe comenzar con sk-or-v1- (crear en https://openrouter.ai/settings/keys).
#
# OPENROUTER_API_KEY=sk-or-v1-...
